# Live Shopify store the logo/footer links back to.
NEXT_PUBLIC_STORE_URL=https://jbracks.com

# Storefront API (Settings > Apps > Develop apps > your app > Storefront API).
# This token is designed to be public — it's the same one Shopify's Buy
# Button/Hydrogen expose client-side — so NEXT_PUBLIC_ is fine here.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Product being sold on this landing page.
NEXT_PUBLIC_SHOPIFY_PRODUCT_HANDLE=4-bike-rack
NEXT_PUBLIC_SHOPIFY_VARIANT_ID=gid://shopify/ProductVariant/00000000000

# ISO timestamp the hero countdown counts down to.
NEXT_PUBLIC_SALE_ENDS_AT=2026-09-30T23:59:59-07:00

# Facebook/Meta Pixel ID (Events Manager > Data Sources > your pixel > Settings).
# Leave blank to disable — no pixel renders until this is set.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Current offer banner on /lp-bike-racks (below the header/ticker). Leave
# NEXT_PUBLIC_OFFER_TEXT blank to hide the banner entirely. Link is optional —
# without one the text renders unlinked.
NEXT_PUBLIC_OFFER_TEXT=
NEXT_PUBLIC_OFFER_LINK=
