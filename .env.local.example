# Live Shopify store the logo/footer links back to.
NEXT_PUBLIC_STORE_URL=https://jbracks.com

# Storefront API (Settings > Apps > Develop apps > your app > Storefront API).
# This token is designed to be public — it's the same one Shopify's Buy
# Button/Hydrogen expose client-side — so NEXT_PUBLIC_ is fine here.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Product being sold on this landing page.
NEXT_PUBLIC_SHOPIFY_PRODUCT_HANDLE=4-bike-rack
NEXT_PUBLIC_SHOPIFY_VARIANT_ID=gid://shopify/ProductVariant/00000000000

# ISO timestamp the hero countdown counts down to.
NEXT_PUBLIC_SALE_ENDS_AT=2026-09-30T23:59:59-07:00

# Facebook/Meta Pixel ID (Events Manager > Data Sources > your pixel > Settings).
# Leave blank to disable — no pixel renders until this is set.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Current offer banner on /lp-bike-racks (below the header/ticker). Leave
# NEXT_PUBLIC_OFFER_TEXT blank to hide the banner entirely. Link is optional —
# without one the text renders unlinked.
NEXT_PUBLIC_OFFER_TEXT=
NEXT_PUBLIC_OFFER_LINK=

# GA4 Measurement ID (Admin > Data Streams > your web stream > Measurement
# ID, looks like G-XXXXXXXXXX). Leave blank to disable — no gtag.js loads
# until this is set. Once set, the /lp-quiz funnel fires quiz_answer and
# quiz_complete events with the selected choices as event params.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Klaviyo private API key (Klaviyo > Settings > API Keys > Private API Keys —
# needs Profiles and Events write scope, and Lists write scope too if you
# set KLAVIYO_LIST_ID below). Server-side only, never exposed to the
# browser. Leave blank to disable — /api/quiz-submit still logs and returns
# success, it just skips the Klaviyo call.
KLAVIYO_PRIVATE_API_KEY=
# Optional: a Klaviyo list ID (List Detail page > URL, or Settings > Lists)
# to subscribe quiz leads to. Leave blank to just track the event/profile
# without subscribing to a list.
KLAVIYO_LIST_ID=

# Resend API key (resend.com > API Keys) — sends every quiz submission as a
# notification email to QUIZ_NOTIFY_EMAIL. Server-only. Leave blank to
# disable — /api/quiz-submit still logs and returns success, it just skips
# sending the email.
RESEND_API_KEY=
# Must be an email on a domain you've verified in Resend (resend.com >
# Domains) once you're past their sandbox — until then the default
# onboarding@resend.dev sender only delivers to your own Resend account
# email. Format: "Name <address@yourdomain.com>".
RESEND_FROM_EMAIL="JB Racks Quiz <onboarding@resend.dev>"
# Who gets the lead notification email for every quiz submission.
QUIZ_NOTIFY_EMAIL=reed@jbracks.com
